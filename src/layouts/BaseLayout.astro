---
import "@fontsource/quicksand/400.css";
import "@fontsource/quicksand/500.css";
import "@fontsource/quicksand/600.css";
import "@fontsource/quicksand/700.css";
import "@fontsource/nunito/400.css";
import "@fontsource/nunito/600.css";
import "@fontsource/nunito/700.css";
import "@/styles/global.css";

import { ClientRouter } from "astro:transitions";
import { site } from "@/data/site";
import { theme } from "@/data/theme";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import Wallpaper from "@/components/Wallpaper.astro";
import MusicPlayer from "@/components/MusicPlayer.astro";
import Live2D from "@/components/Live2D.astro";

interface Props {
  title?: string;
  description?: string;
  /** 页面主色，用于视觉小差异（暂未强用，保留扩展） */
  ogType?: string;
  /** 文章页传进来，用于输出 BlogPosting 结构化数据 */
  jsonLd?: Record<string, unknown>;
}
const {
  title,
  description = site.intro,
  ogType = "website",
  jsonLd,
} = Astro.props;

const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.role}`;
const origin = Astro.site ?? new URL(site.url);
const canonical = new URL(Astro.url.pathname, origin).href;

// 有分享图才输出 og:image；没有就把 twitter:card 降级成 summary，
// 否则 summary_large_image 会渲染成一张空白大卡
const ogImage = theme.ogImage ? new URL(theme.ogImage, origin).href : null;

// 只有真正填了的外部主页才进 sameAs（RSS / mailto 不算）
const sameAs = site.social
  .filter((s) => s.url.startsWith("http"))
  .map((s) => s.url);

const structuredData = jsonLd ?? {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.fullName,
  alternateName: site.name,
  description: site.intro,
  url: origin.href,
  jobTitle: site.role,
  ...(site.email ? { email: `mailto:${site.email}` } : {}),
  ...(sameAs.length ? { sameAs } : {}),
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      document.documentElement.classList.add("js");
      // 兜底：.js .reveal 是 opacity:0，取消隐藏的代码在打包后的 module 里。
      // 万一那个 bundle 加载失败 / astro:page-load 没触发，整页会永远空白，
      // 所以这里留一个 2.5s 的保险丝，到点就把内容无条件放出来。
      setTimeout(function () {
        document.documentElement.classList.add("reveal-fallback");
      }, 2500);
      // 首屏前就定好主题，避免闪白
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (t !== "light" && t !== "dark") {
            t = window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
          }
          document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.fullName} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* theme-color 跟随系统深/浅色；JS 初始化后会用精确计算色覆盖 */}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fbe4ee" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#262130" />

    {/* 霞鹜文楷 Screen：CDN 按 unicode-range 切片，只下载当前页用到的字形 */}
    <link rel="preconnect" href="https://fastly.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://fastly.jsdelivr.net/npm/lxgw-wenkai-screen-webfont@1.7.0/lxgwwenkaiscreen.css"
    />

    {
      /* Live2D 样式放进每页 SSR <head>，否则视图过渡换页时会被移除、看板娘变形 */
      theme.live2d && (
        <link
          rel="stylesheet"
          href="https://fastly.jsdelivr.net/npm/live2d-widgets@1.0.1/dist/waifu.css"
          data-l2d
        />
      )
    }

    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} 的博客`}
      href={new URL("/rss.xml", origin).href}
    />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="zh_CN" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta
      name="twitter:card"
      content={ogImage ? "summary_large_image" : "summary"}
    />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />

    <ClientRouter />
  </head>

  <body>
    <Wallpaper />
    <a href="#main" class="skip-link">跳到主要内容</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MusicPlayer transition:persist="music-player" />
    {theme.live2d && <Live2D />}

    <script>
      // 滚动进入视口时优雅淡入；无 JS 时内容照常可见（见 .js 作用域）
      function initReveal() {
        const els = document.querySelectorAll<HTMLElement>(
          ".reveal:not(.is-visible)",
        );
        if (!els.length) return;
        const io = new IntersectionObserver(
          (entries, obs) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                obs.unobserve(entry.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      }
      document.addEventListener("astro:page-load", initReveal);
    </script>

    <script>
      // 深色 / 浅色切换
      function themeCurrent() {
        return document.documentElement.dataset.theme === "dark"
          ? "dark"
          : "light";
      }
      function themeSync(t: string) {
        document
          .querySelectorAll("[data-theme-toggle]")
          .forEach((b) => b.setAttribute("aria-pressed", String(t === "dark")));
        // 用实际的页面底色精确同步浏览器 UI 颜色
        const syncMeta = () => {
          const bg = getComputedStyle(document.body).backgroundColor;
          if (bg) {
            document
              .querySelectorAll('meta[name="theme-color"]')
              .forEach((m) => m.setAttribute("content", bg));
          }
        };
        syncMeta();
        // body 背景有 0.38s 过渡，切换主题时再取一次过渡结束后的终值
        setTimeout(syncMeta, 450);
      }
      function themeApply(t: string) {
        document.documentElement.dataset.theme = t;
        try {
          localStorage.setItem("theme", t);
        } catch (e) {}
        themeSync(t);
      }
      document.addEventListener("click", (e) => {
        const target = e.target as Element | null;
        const btn = target?.closest?.("[data-theme-toggle]");
        if (!btn) return;
        themeApply(themeCurrent() === "dark" ? "light" : "dark");
      });
      // 视图过渡换页后 <html> 属性会被覆盖，绘制前补回来避免闪烁
      document.addEventListener("astro:after-swap", () => {
        try {
          let t = localStorage.getItem("theme");
          if (t !== "light" && t !== "dark") t = themeCurrent();
          document.documentElement.dataset.theme = t;
          themeSync(t);
        } catch (e) {}
      });
      themeSync(themeCurrent());
    </script>

    <style>
      .skip-link {
        position: fixed;
        top: 0.6rem;
        left: 50%;
        transform: translate(-50%, -160%);
        z-index: 100;
        padding: 0.6rem 1.2rem;
        border-radius: var(--radius-pill);
        background: var(--sakura-deep);
        color: var(--btn-ink);
        font-family: var(--font-display);
        font-weight: 700;
        font-size: var(--text-sm);
        transition: transform var(--dur) var(--ease-soft);
      }
      .skip-link:focus {
        transform: translate(-50%, 0);
      }
    </style>
  </body>
</html>
