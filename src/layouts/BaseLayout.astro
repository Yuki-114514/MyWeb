---
import "@fontsource/quicksand/400.css";
import "@fontsource/quicksand/500.css";
import "@fontsource/quicksand/600.css";
import "@fontsource/quicksand/700.css";
import "@fontsource/nunito/400.css";
import "@fontsource/nunito/600.css";
import "@fontsource/nunito/700.css";
import "@/styles/global.css";

import { ClientRouter } from "astro:transitions";
import { site } from "@/data/site";
import { theme } from "@/data/theme";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import Wallpaper from "@/components/Wallpaper.astro";
import MusicPlayer from "@/components/MusicPlayer.astro";
import Live2D from "@/components/Live2D.astro";

interface Props {
  title?: string;
  description?: string;
  /** 页面主色，用于视觉小差异（暂未强用，保留扩展） */
  ogType?: string;
}
const {
  title,
  description = site.intro,
  ogType = "website",
} = Astro.props;

const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      document.documentElement.classList.add("js");
      // 首屏前就定好主题，避免闪白
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (t !== "light" && t !== "dark") {
            t = window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
          }
          document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.fullName} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#fbe4ee" />

    {/* 霞鹜文楷 Screen：CDN 按 unicode-range 切片，只下载当前页用到的字形 */}
    <link rel="preconnect" href="https://fastly.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://fastly.jsdelivr.net/npm/lxgw-wenkai-screen-webfont@1.7.0/lxgwwenkaiscreen.css"
    />

    {
      /* Live2D 样式放进每页 SSR <head>，否则视图过渡换页时会被移除、看板娘变形 */
      theme.live2d && (
        <link
          rel="stylesheet"
          href="https://fastly.jsdelivr.net/npm/live2d-widgets@1.0.1/dist/waifu.css"
          data-l2d
        />
      )
    }

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />

    <ClientRouter />
  </head>

  <body>
    <Wallpaper />
    <a href="#main" class="skip-link">跳到主要内容</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MusicPlayer transition:persist="music-player" />
    {theme.live2d && <Live2D />}

    <script>
      // 滚动进入视口时优雅淡入；无 JS 时内容照常可见（见 .js 作用域）
      function initReveal() {
        const els = document.querySelectorAll<HTMLElement>(
          ".reveal:not(.is-visible)",
        );
        if (!els.length) return;
        const io = new IntersectionObserver(
          (entries, obs) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                obs.unobserve(entry.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      }
      document.addEventListener("astro:page-load", initReveal);
    </script>

    <script>
      // 深色 / 浅色切换
      function themeCurrent() {
        return document.documentElement.dataset.theme === "dark"
          ? "dark"
          : "light";
      }
      function themeSync(t: string) {
        document
          .querySelectorAll("[data-theme-toggle]")
          .forEach((b) => b.setAttribute("aria-pressed", String(t === "dark")));
      }
      function themeApply(t: string) {
        document.documentElement.dataset.theme = t;
        try {
          localStorage.setItem("theme", t);
        } catch (e) {}
        themeSync(t);
      }
      document.addEventListener("click", (e) => {
        const target = e.target as Element | null;
        const btn = target?.closest?.("[data-theme-toggle]");
        if (!btn) return;
        themeApply(themeCurrent() === "dark" ? "light" : "dark");
      });
      // 视图过渡换页后 <html> 属性会被覆盖，绘制前补回来避免闪烁
      document.addEventListener("astro:after-swap", () => {
        try {
          let t = localStorage.getItem("theme");
          if (t !== "light" && t !== "dark") t = themeCurrent();
          document.documentElement.dataset.theme = t;
          themeSync(t);
        } catch (e) {}
      });
      themeSync(themeCurrent());
    </script>

    <style>
      .skip-link {
        position: fixed;
        top: 0.6rem;
        left: 50%;
        transform: translate(-50%, -160%);
        z-index: 100;
        padding: 0.6rem 1.2rem;
        border-radius: var(--radius-pill);
        background: var(--sakura-deep);
        color: white;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: var(--text-sm);
        transition: transform var(--dur) var(--ease-soft);
      }
      .skip-link:focus {
        transform: translate(-50%, 0);
      }
    </style>
  </body>
</html>
