---
import { site } from "@/data/site";
import SocialLinks from "./SocialLinks.astro";
import Icon from "./Icon.astro";
import SakuraMark from "./SakuraMark.astro";

const year = 2024;
---

<footer class="footer">
  <div class="wave" aria-hidden="true">
    <svg viewBox="0 0 1200 60" preserveAspectRatio="none">
      <path
        d="M0 30 C 150 60 300 0 450 30 C 600 60 750 0 900 30 C 1050 60 1200 10 1200 10 L1200 60 L0 60 Z"
      ></path>
    </svg>
  </div>

  <div class="footer-inner container">
    <div class="footer-top">
      <div class="footer-brand">
        <p class="footer-name">
          <SakuraMark size="1.25em" class="footer-mark" />
          {site.name}
        </p>
        <p class="footer-tagline">{site.tagline}</p>
      </div>
      <nav class="footer-nav" aria-label="页脚导航">
        {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </div>

    <div class="footer-bottom">
      <SocialLinks />
      <p class="footer-copy">
        © {year} {site.fullName} · 用 <Icon name="flower" class="copy-flower" /> 与 <a
          href="https://astro.build"
          class="link"
          target="_blank"
          rel="noopener">Astro</a
        > 精心搭建
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    margin-top: var(--space-section);
    padding-top: 3.5rem;
    padding-bottom: 2.5rem;
    background: linear-gradient(
      180deg,
      transparent 0%,
      oklch(98% 0.012 330 / 0.5) 28%,
      oklch(98% 0.012 330 / 0.82)
    );
    backdrop-filter: blur(10px) saturate(1.3);
    -webkit-backdrop-filter: blur(10px) saturate(1.3);
  }
  .wave {
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: 48px;
    transform: translateY(-98%);
    color: oklch(98% 0.012 330 / 0.8);
  }
  .wave svg {
    width: 100%;
    height: 100%;
  }
  .wave path {
    fill: currentColor;
    opacity: 0.6;
  }

  .footer-top {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2rem;
    justify-content: space-between;
    align-items: flex-start;
    padding-bottom: 2rem;
    border-bottom: 1.5px dashed var(--line-strong);
  }
  .footer-name {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-xl);
  }
  .footer-mark {
    vertical-align: -0.28em;
  }
  .footer-tagline {
    margin-top: 0.35rem;
    color: var(--ink-soft);
    font-size: var(--text-sm);
  }
  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.1rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-sm);
  }
  .footer-nav a {
    color: var(--ink-soft);
    transition: color var(--dur) var(--ease);
  }
  .footer-nav a:hover {
    color: var(--sakura-deep);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.8rem;
  }
  .footer-copy {
    color: var(--ink-faint);
    font-size: var(--text-sm);
  }
  .copy-flower {
    color: var(--sakura-deep);
  }

  :global(html[data-theme="dark"]) .footer {
    background: linear-gradient(
      180deg,
      transparent 0%,
      oklch(22% 0.03 290 / 0.5) 28%,
      oklch(19% 0.03 290 / 0.82)
    );
  }
  :global(html[data-theme="dark"]) .wave {
    color: oklch(19% 0.03 290 / 0.8);
  }
</style>
