---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "@/lib/format";
import Icon from "@/components/Icon.astro";

interface Props {
  post: CollectionEntry<"blog">;
  /** 卡片标题的层级。列表页父级只有 h1 时传 2，首页有 SectionHeading(h2) 时用默认的 3 */
  headingLevel?: 2 | 3;
}
const { post, headingLevel = 3 } = Astro.props;
const { title, description, pubDate, tags, icon } = post.data;
const Title = `h${headingLevel}` as "h2" | "h3";
---

<a href={`/blog/${post.id}`} class="post card">
  <span class="post-icon" aria-hidden="true">
    <Icon name={icon} />
  </span>
  <div class="post-body">
    <div class="post-meta">
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      {tags[0] && <span class="post-tag">#{tags[0]}</span>}
    </div>
    <Title class="post-title">{title}</Title>
    <p class="post-desc">{description}</p>
  </div>
  <span class="post-arrow" aria-hidden="true">→</span>
</a>

<style>
  .post {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    padding: 1.3rem 1.5rem;
  }
  .post:hover {
    transform: translateY(-4px);
    border-color: var(--sakura);
    box-shadow: var(--shadow);
  }
  .post-icon {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 3.2rem;
    height: 3.2rem;
    font-size: 1.7rem;
    color: var(--sakura-deep);
    border-radius: var(--radius);
    background: linear-gradient(135deg, var(--sakura-soft), var(--sky-soft));
    transition: transform var(--dur) var(--ease-soft);
  }
  .post:hover .post-icon {
    transform: rotate(8deg) scale(1.08);
  }

  .post-body {
    flex: 1;
    min-width: 0;
  }
  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-xs);
    color: var(--ink-faint);
    margin-bottom: 0.3rem;
  }
  .post-tag {
    color: var(--sakura-deep);
  }
  .post-title {
    font-size: var(--text-lg);
    margin-bottom: 0.3rem;
    transition: color var(--dur) var(--ease);
  }
  .post:hover .post-title {
    color: var(--sakura-deep);
  }
  .post-desc {
    color: var(--ink-soft);
    font-size: var(--text-sm);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-arrow {
    flex-shrink: 0;
    color: var(--sakura-deep);
    font-size: 1.3rem;
    transition: transform var(--dur) var(--ease-soft);
  }
  .post:hover .post-arrow {
    transform: translateX(5px);
  }

  @media (max-width: 34rem) {
    .post-arrow {
      display: none;
    }
    .post {
      gap: 0.9rem;
      padding: 1.1rem;
    }
  }
</style>
