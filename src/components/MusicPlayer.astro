---
import { music } from "@/data/music";

const data = { tracks: music.tracks, autoplay: music.autoplay };
// 没歌就整个不渲染。原来会留一枚点不动的唱片浮在左下角挡内容
const hasTracks = music.tracks.length > 0;
---

{hasTracks && (
<div id="music-player" class="mplayer" data-first={music.tracks[0]?.title}>
  <!-- 歌单弹层（向上展开） -->
  <ul class="mp-list" role="listbox" aria-label="播放列表">
    {
      music.tracks.map((t, i) => (
        <li
          class="mp-track"
          data-i={i}
          role="option"
          tabindex="-1"
          aria-selected={i === 0 ? "true" : "false"}
        >
          <span class="mp-track-idx">{String(i + 1).padStart(2, "0")}</span>
          <span class="mp-track-meta">
            <span class="mp-track-title">{t.title}</span>
            <span class="mp-track-artist">{t.artist}</span>
          </span>
          <span class="mp-track-eq" aria-hidden="true">
            <i></i><i></i><i></i>
          </span>
        </li>
      ))
    }
  </ul>

  <div class="mp-main">
    <button
      class="mp-cover"
      data-act="toggle"
      aria-label="播放 / 暂停"
      title="播放 / 暂停（拖动可挪动位置）"
    >
      <img class="mp-cover-img" alt="" draggable="false" />
      <span class="mp-cover-note" aria-hidden="true">♪</span>
    </button>

    {/* 默认收起为一枚唱片；悬停 / 聚焦时向右滑出 */}
    <div class="mp-detail">
      <div class="mp-detail-inner">
        <div class="mp-info">
          <div class="mp-title">暂未播放</div>
          <div class="mp-artist">点击封面开始</div>
          <div
            class="mp-bar"
            role="slider"
            aria-label="播放进度"
            tabindex="0"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="0"
            aria-valuetext="0:00"
          >
            <div class="mp-fill"></div>
          </div>
          <div class="mp-time">0:00</div>
        </div>

        <div class="mp-controls">
          <button data-act="prev" aria-label="上一首" title="上一首">⏮</button>
          <button data-act="play" class="mp-play" aria-label="播放 / 暂停" title="播放 / 暂停">
            <span class="mp-icon">▶</span>
          </button>
          <button data-act="next" aria-label="下一首" title="下一首">⏭</button>
          <button data-act="list" aria-label="播放列表" title="播放列表">☰</button>
        </div>
      </div>
    </div>
  </div>

  <script type="application/json" set:html={JSON.stringify(data)} data-mp-data></script>
  <audio preload="none"></audio>
</div>
)}

<script>
  function initPlayer() {
    const el = document.getElementById("music-player");
    if (!el || el.dataset.ready) return;
    // 单独绑一个非空的 const，否则下面那些函数体里 root 会被 TS 当成可能为 null
    const root: HTMLElement = el;
    root.dataset.ready = "1";

    const q = <T extends Element>(s: string) => root.querySelector(s) as T;
    const data = JSON.parse(
      q<HTMLScriptElement>("[data-mp-data]").textContent || "{}",
    );
    const tracks: { title: string; artist: string; src: string; cover?: string }[] =
      data.tracks || [];
    if (!tracks.length) return;

    const audio = q<HTMLAudioElement>("audio");
    const cover = q<HTMLElement>(".mp-cover");
    const coverImg = q<HTMLImageElement>(".mp-cover-img");
    const titleEl = q<HTMLElement>(".mp-title");
    const artistEl = q<HTMLElement>(".mp-artist");
    const fill = q<HTMLElement>(".mp-fill");
    const timeEl = q<HTMLElement>(".mp-time");
    const playIcon = q<HTMLElement>(".mp-icon");
    const listEl = q<HTMLElement>(".mp-list");
    const items = Array.from(root.querySelectorAll<HTMLElement>(".mp-track"));
    let idx = 0;

    const fmt = (s: number) => {
      s = Math.floor(s || 0);
      return Math.floor(s / 60) + ":" + String(s % 60).padStart(2, "0");
    };

    function load(i: number, play: boolean) {
      idx = (i + tracks.length) % tracks.length;
      const t = tracks[idx];
      audio.src = t.src;
      titleEl.textContent = t.title;
      artistEl.textContent = t.artist;
      if (t.cover) {
        coverImg.src = t.cover;
        coverImg.style.opacity = "1";
      } else {
        coverImg.removeAttribute("src");
        coverImg.style.opacity = "0";
      }
      items.forEach((li, n) => {
        li.classList.toggle("active", n === idx);
        li.setAttribute("aria-selected", String(n === idx));
      });
      if (play) audio.play().catch(() => {});
    }

    function setPlaying(p: boolean) {
      root.classList.toggle("playing", p);
      playIcon.textContent = p ? "⏸" : "▶";
    }

    const toggle = () => (audio.paused ? audio.play() : audio.pause());
    cover.addEventListener("click", () => {
      if (skipClick) {
        skipClick = false; // 拖拽结束后的那次 click 不触发播放
        return;
      }
      toggle();
    });
    q('[data-act="play"]').addEventListener("click", toggle);
    q('[data-act="prev"]').addEventListener("click", () => load(idx - 1, true));
    q('[data-act="next"]').addEventListener("click", () => load(idx + 1, true));
    q('[data-act="list"]').addEventListener("click", () =>
      root.classList.toggle("open"),
    );
    items.forEach((li, n) =>
      li.addEventListener("click", () => {
        load(n, true);
        root.classList.remove("open");
      }),
    );

    audio.addEventListener("play", () => setPlaying(true));
    audio.addEventListener("pause", () => setPlaying(false));
    audio.addEventListener("ended", () => load(idx + 1, true));
    const bar = q<HTMLElement>(".mp-bar");

    function seekTo(ratio: number) {
      if (!audio.duration) return;
      audio.currentTime = Math.max(0, Math.min(1, ratio)) * audio.duration;
    }

    audio.addEventListener("timeupdate", () => {
      if (audio.duration) {
        const pct = (audio.currentTime / audio.duration) * 100;
        fill.style.width = pct + "%";
        timeEl.textContent = fmt(audio.currentTime) + " / " + fmt(audio.duration);
        bar.setAttribute("aria-valuenow", String(Math.round(pct)));
        bar.setAttribute(
          "aria-valuetext",
          fmt(audio.currentTime) + " / " + fmt(audio.duration),
        );
      }
    });

    bar.addEventListener("click", (e) => {
      const r = bar.getBoundingClientRect();
      seekTo((e.clientX - r.left) / r.width);
    });

    // 进度条能聚焦就必须能用键盘操作，否则 role="slider" 是个空壳
    bar.addEventListener("keydown", (e) => {
      if (!audio.duration) return;
      const step = e.shiftKey ? 30 : 5; // 秒
      const jump: Record<string, number> = {
        ArrowLeft: -step,
        ArrowDown: -step,
        ArrowRight: step,
        ArrowUp: step,
      };
      if (e.key in jump) {
        seekTo((audio.currentTime + jump[e.key]) / audio.duration);
      } else if (e.key === "Home") {
        seekTo(0);
      } else if (e.key === "End") {
        seekTo(1);
      } else if (e.key === " " || e.key === "Enter") {
        toggle();
      } else {
        return;
      }
      e.preventDefault();
    });

    // 点击播放器外部收起歌单
    document.addEventListener("click", (e) => {
      if (root.classList.contains("open") && !root.contains(e.target as Node)) {
        root.classList.remove("open");
      }
    });

    // ---- 唱片可自由拖动，位置记忆在 localStorage ----
    const POS_KEY = "mp-pos";
    const EDGE = 8; // 与屏幕边缘的最小间距
    let grabX = 0;
    let grabY = 0;
    let downX = 0;
    let downY = 0;
    let moved = false;
    let skipClick = false;

    // 以封面为基准定位根元素；封面越过屏幕中线时翻转向左展开
    function place(cx: number, cy: number) {
      const cw = cover.offsetWidth;
      const ch = cover.offsetHeight;
      cx = Math.max(EDGE, Math.min(window.innerWidth - cw - EDGE, cx));
      cy = Math.max(EDGE, Math.min(window.innerHeight - ch - EDGE, cy));
      root.classList.toggle("flip", cx + cw / 2 > window.innerWidth / 2);
      const rr = root.getBoundingClientRect();
      const cr = cover.getBoundingClientRect();
      root.style.left = cx - (cr.left - rr.left) + "px";
      root.style.top = cy - (cr.top - rr.top) + "px";
      root.style.bottom = "auto";
    }

    function savePos() {
      const cr = cover.getBoundingClientRect();
      try {
        localStorage.setItem(POS_KEY, JSON.stringify({ x: cr.left, y: cr.top }));
      } catch {}
    }

    // 用户是否亲手定过位。没定过就一直用 CSS 的默认锚点（左下角），
    // 否则 resize 一触发就会把 bottom 锚点换成 top，播放器凭空往上跳。
    let placed = false;

    function restorePos() {
      try {
        const p = JSON.parse(localStorage.getItem(POS_KEY) || "null");
        if (p && Number.isFinite(p.x) && Number.isFinite(p.y)) {
          place(p.x, p.y);
          placed = true;
        }
      } catch {}
    }

    cover.addEventListener("pointerdown", (e) => {
      if (e.pointerType === "mouse" && e.button !== 0) return;
      skipClick = false; // 上次拖拽若没落到封面上的 click，不吞这次的播放
      const cr = cover.getBoundingClientRect();
      grabX = e.clientX - cr.left;
      grabY = e.clientY - cr.top;
      downX = e.clientX;
      downY = e.clientY;
      moved = false;
      cover.setPointerCapture(e.pointerId);
    });
    cover.addEventListener("pointermove", (e) => {
      if (!cover.hasPointerCapture(e.pointerId)) return;
      if (!moved) {
        if (Math.hypot(e.clientX - downX, e.clientY - downY) < 6) return;
        moved = true;
        root.classList.add("drag");
      }
      place(e.clientX - grabX, e.clientY - grabY);
    });
    const endDrag = (e: PointerEvent) => {
      if (!cover.hasPointerCapture(e.pointerId)) return;
      cover.releasePointerCapture(e.pointerId);
      if (moved) {
        savePos();
        placed = true;
        skipClick = true;
      }
      moved = false;
      root.classList.remove("drag");
    };
    cover.addEventListener("pointerup", endDrag);
    cover.addEventListener("pointercancel", endDrag);
    window.addEventListener("resize", () => {
      // 只在用户自己挪过位置时才夹回视口内；没挪过就别碰它
      if (!placed) return;
      const cr = cover.getBoundingClientRect();
      place(cr.left, cr.top);
    });
    restorePos();

    load(0, data.autoplay);
  }

  initPlayer();
  document.addEventListener("astro:page-load", initPlayer);
</script>

<style>
  .mplayer {
    position: fixed;
    left: 1.2rem;
    bottom: 1.2rem;
    z-index: 45;
    width: fit-content;
    pointer-events: none; /* 收起的歌单弹层是隐形的，不挡页面点击 */
    font-family: var(--font-display);
    color: var(--ink);
  }

  .mp-main {
    position: relative;
    display: flex;
    align-items: center;
    width: fit-content; /* 不随歌单弹层撑宽，收起时只剩一枚唱片 */
    padding: 0.6rem;
    border-radius: var(--radius-lg);
    pointer-events: auto;
  }

  /* 玻璃底只在展开时淡入：收起态是裸唱片 */
  .mp-main::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: oklch(99.5% 0.004 95 / 0.7);
    backdrop-filter: blur(16px) saturate(1.5);
    -webkit-backdrop-filter: blur(16px) saturate(1.5);
    border: 1.5px solid oklch(100% 0 0 / 0.65);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    transition: opacity 0.35s var(--ease);
  }
  /* 只有悬停 / 聚焦唱片本体，或歌单打开时才亮玻璃 */
  .mplayer:not(.drag) .mp-main:is(:hover, :focus-within)::before,
  .mplayer.open .mp-main::before {
    opacity: 1;
    transition-delay: 0.08s; /* 宽度先开始展开，玻璃随后淡入 */
  }

  /* 收起态：宽度 0、透明；只有鼠标在唱片上才滑出详情 */
  .mp-detail {
    width: 0;
    margin: 0;
    opacity: 0;
    overflow: hidden;
    transition:
      width 0.55s var(--ease),
      margin 0.55s var(--ease),
      opacity 0.3s var(--ease);
  }
  .mp-detail-inner {
    width: 17.7rem;
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
  .mplayer:not(.drag) .mp-main:is(:hover, :focus-within) .mp-detail,
  .mplayer.open .mp-detail {
    width: 17.7rem;
    margin-left: 0.7rem;
    opacity: 1;
    transition:
      width 0.55s var(--ease),
      margin 0.55s var(--ease),
      opacity 0.35s var(--ease) 0.12s;
  }

  /* 唱片拖到屏幕右半：详情改向左侧展开，避免溢出 */
  .mplayer.flip .mp-main {
    margin-left: auto;
    flex-direction: row-reverse;
  }
  .mplayer.flip:not(.drag) .mp-main:is(:hover, :focus-within) .mp-detail,
  .mplayer.flip.open .mp-detail {
    margin-left: 0;
    margin-right: 0.7rem;
  }

  /* 封面唱片 */
  .mp-cover {
    position: relative;
    flex-shrink: 0;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    overflow: hidden;
    background: linear-gradient(135deg, var(--sakura), var(--lavender));
    box-shadow:
      inset 0 0 0 3px oklch(100% 0 0 / 0.55),
      var(--shadow-sm);
    display: grid;
    place-items: center;
    cursor: grab;
    touch-action: none; /* 触屏拖动时不滚页面 */
    user-select: none;
    -webkit-user-select: none;
  }
  .mp-cover-img,
  .mp-cover-note {
    -webkit-user-drag: none; /* 防止封面图触发浏览器原生拖图，抢走指针 */
  }
  .mplayer.drag .mp-cover {
    cursor: grabbing;
  }
  .mp-cover-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }
  .mp-cover-note {
    color: white;
    font-size: 1.2rem;
    text-shadow: 0 1px 3px oklch(40% 0.1 340 / 0.6);
  }
  .mplayer.playing .mp-cover {
    animation: spin-disc 8s linear infinite;
  }
  @keyframes spin-disc {
    to {
      transform: rotate(360deg);
    }
  }

  .mp-info {
    flex: 1;
    min-width: 0;
  }
  .mp-title {
    font-weight: 700;
    font-size: var(--text-sm);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mp-artist {
    font-size: var(--text-xs);
    color: var(--ink-faint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mp-bar {
    margin-top: 0.35rem;
    height: 5px;
    border-radius: var(--radius-pill);
    background: var(--line-strong);
    cursor: pointer;
    overflow: hidden;
  }
  .mp-fill {
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--sakura-deep), var(--lavender-deep));
    transition: width 0.15s linear;
  }
  .mp-time {
    margin-top: 0.15rem;
    font-size: 0.68rem;
    color: var(--ink-faint);
  }

  .mp-controls {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    flex-shrink: 0;
  }
  .mp-controls button {
    /*
     * 2.4rem ≈ 38px。这一组是唯一没做到 44px 的控件：四颗并排 44px
     * 会把展开面板顶到 22rem 以上，375px 手机放不下。主控（播放/暂停）
     * 是外面那枚 3rem 的唱片，本身够大，这四颗是次要操作。
     */
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    color: var(--ink-soft);
    font-size: 0.95rem;
    display: grid;
    place-items: center;
    transition:
      background var(--dur) var(--ease),
      color var(--dur) var(--ease),
      transform var(--dur-fast) var(--ease-soft);
  }
  .mp-controls button:hover {
    background: var(--sakura-soft);
    color: var(--sakura-deep);
    transform: scale(1.12);
  }
  .mp-play {
    color: var(--sakura-deep) !important;
    background: var(--sakura-soft);
  }

  /* 歌单弹层 */
  .mp-list {
    list-style: none;
    width: min(330px, calc(100vw - 2.4rem));
    margin: 0 0 0.5rem;
    padding: 0.4rem;
    max-height: 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    overflow: hidden auto;
    border-radius: var(--radius-lg);
    background: oklch(99.5% 0.004 95 / 0.78);
    backdrop-filter: blur(16px) saturate(1.5);
    -webkit-backdrop-filter: blur(16px) saturate(1.5);
    border: 1.5px solid transparent;
    transform: translateY(8px);
    transition:
      max-height var(--dur) var(--ease),
      opacity var(--dur) var(--ease),
      transform var(--dur) var(--ease),
      visibility var(--dur);
  }
  .mplayer.open .mp-list {
    max-height: 240px;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: none;
    border-color: oklch(100% 0 0 / 0.65);
    box-shadow: var(--shadow-lg);
  }
  .mp-track {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.6rem;
    border-radius: var(--radius);
    cursor: pointer;
    transition: background var(--dur) var(--ease);
  }
  .mp-track:hover {
    background: var(--sakura-soft);
  }
  .mp-track-idx {
    font-size: 0.72rem;
    color: var(--ink-faint);
    font-weight: 700;
  }
  .mp-track-meta {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .mp-track-title {
    font-size: var(--text-sm);
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mp-track-artist {
    font-size: 0.68rem;
    color: var(--ink-faint);
  }
  .mp-track.active .mp-track-title {
    color: var(--sakura-deep);
  }
  .mp-track.active .mp-track-idx {
    color: var(--sakura-deep);
  }

  /* 播放中的小律动条 */
  .mp-track-eq {
    display: none;
    align-items: flex-end;
    gap: 2px;
    height: 12px;
  }
  .mp-track.active .mp-track-eq {
    display: flex;
  }
  .mp-track-eq i {
    width: 3px;
    background: var(--sakura-deep);
    border-radius: 2px;
    animation: eq 0.9s ease-in-out infinite;
  }
  .mp-track-eq i:nth-child(2) {
    animation-delay: 0.3s;
  }
  .mp-track-eq i:nth-child(3) {
    animation-delay: 0.6s;
  }
  @keyframes eq {
    0%, 100% {
      height: 4px;
    }
    50% {
      height: 12px;
    }
  }

  /* left / bottom 交给下面 52rem 那块统一管（带 safe-area），这里只夹宽度 */
  @media (max-width: 30rem) {
    .mp-detail-inner {
      width: min(17.7rem, calc(100vw - 6.5rem));
    }
    .mplayer:not(.drag) .mp-main:is(:hover, :focus-within) .mp-detail,
    .mplayer.open .mp-detail {
      width: min(17.7rem, calc(100vw - 6.5rem));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mplayer.playing .mp-cover,
    .mp-track-eq i {
      animation: none;
    }
    .mp-detail,
    .mp-main::before {
      transition: none;
    }
  }

  /* 深色玻璃播放器 */
  :global(html[data-theme="dark"]) .mp-main::before,
  :global(html[data-theme="dark"]) .mp-list {
    background: oklch(28% 0.03 290 / 0.74);
  }
  :global(html[data-theme="dark"]) .mp-main::before {
    border-color: oklch(80% 0.02 300 / 0.16);
  }
  :global(html[data-theme="dark"]) .mplayer.open .mp-list {
    border-color: oklch(80% 0.02 300 / 0.16);
  }

  /*
   * 窄屏：唱片是固定定位的，会压在正文上。缩小一圈、贴紧边角、
   * 没在播放时降到 55% 透明度，让它退到文字后面而不是抢镜。
   */
  @media (max-width: 52rem) {
    .mplayer {
      left: 0.75rem;
      bottom: calc(0.75rem + env(safe-area-inset-bottom, 0px));
    }
    /* 唱片本身是主控（播放/暂停 + 拖动把手），保持 44px */
    .mp-cover {
      width: 2.75rem;
      height: 2.75rem;
    }
    .mplayer:not(.playing):not(.open) .mp-main {
      opacity: 0.55;
    }
    .mplayer .mp-main {
      transition: opacity var(--dur) var(--ease);
    }
    .mplayer .mp-main:is(:hover, :focus-within) {
      opacity: 1;
    }
  }
</style>
