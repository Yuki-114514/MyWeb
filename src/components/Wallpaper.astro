---
import { theme } from "@/data/theme";

const hasWp = theme.wallpaper.trim().length > 0;
const wpMobile = theme.wallpaperMobile || theme.wallpaper;

// 少量花瓣，比之前更克制
const petals = [
  { left: 8, size: 12, dur: 17, delay: 0, drift: 40, spin: 220, hue: 350 },
  { left: 24, size: 9, dur: 21, delay: 5, drift: -28, spin: -180, hue: 340 },
  { left: 42, size: 14, dur: 15, delay: 2, drift: 55, spin: 300, hue: 320 },
  { left: 58, size: 8, dur: 24, delay: 8, drift: -22, spin: -240, hue: 230 },
  { left: 72, size: 13, dur: 18, delay: 3, drift: 34, spin: 200, hue: 350 },
  { left: 88, size: 10, dur: 20, delay: 6, drift: -40, spin: -200, hue: 300 },
];

// 深色模式下花瓣换成萤火虫（夜幕微光）
const fireflies = [
  { left: 10, top: 30, size: 5, dur: 9, delay: 0, dx: 46, dy: -30 },
  { left: 22, top: 62, size: 4, dur: 11, delay: 2.5, dx: -38, dy: -44 },
  { left: 36, top: 20, size: 6, dur: 10, delay: 1.2, dx: 52, dy: 36 },
  { left: 52, top: 70, size: 4, dur: 12, delay: 4, dx: -44, dy: -36 },
  { left: 64, top: 38, size: 5, dur: 9.5, delay: 0.8, dx: 40, dy: 42 },
  { left: 78, top: 60, size: 6, dur: 11.5, delay: 3.2, dx: -50, dy: -28 },
  { left: 90, top: 26, size: 4, dur: 10.5, delay: 5, dx: -34, dy: 40 },
  { left: 45, top: 48, size: 3.5, dur: 13, delay: 6, dx: 36, dy: -46 },
];
---

<div
  class="wallpaper"
  aria-hidden="true"
  style={`--wp:url('${theme.wallpaper}');--wp-m:url('${wpMobile}');--ov:${theme.overlay};--ov-dark:${theme.overlayDark};--blur:${theme.wallpaperBlur}px`}
>
  {hasWp ? <div class="wp-img"></div> : <div class="wp-fallback"></div>}
  <div class="wp-veil"></div>
  {
    theme.petals && (
      <>
        <div class="petals">
          {petals.map((p) => (
            <span
              class="petal"
              style={`--left:${p.left}%;--s:${p.size}px;--dur:${p.dur}s;--delay:${p.delay}s;--drift:${p.drift}px;--spin:${p.spin}deg;--hue:${p.hue}`}
            />
          ))}
        </div>
        <div class="fireflies">
          {fireflies.map((f) => (
            <span
              class="firefly"
              style={`--left:${f.left}%;--top:${f.top}%;--s:${f.size}px;--dur:${f.dur}s;--delay:${f.delay}s;--dx:${f.dx}px;--dy:${f.dy}px`}
            />
          ))}
        </div>
      </>
    )
  }
</div>

<style>
  .wallpaper {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .wp-img {
    position: absolute;
    inset: -4%;
    background-image: var(--wp);
    background-size: cover;
    background-position: center;
    filter: blur(var(--blur)) saturate(1.05);
    transform: scale(1.06);
  }
  .wp-fallback {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 50% at 20% 10%, oklch(90% 0.08 350 / 0.9), transparent 70%),
      radial-gradient(60% 55% at 85% 20%, oklch(90% 0.07 232 / 0.85), transparent 70%),
      radial-gradient(70% 60% at 60% 100%, oklch(90% 0.07 300 / 0.85), transparent 70%),
      var(--cream);
  }

  /* 柔纱层：颜色随主题切换（token），浓度由 --ov 控制 */
  .wp-veil {
    position: absolute;
    inset: 0;
    opacity: var(--ov);
    background: linear-gradient(
      180deg,
      var(--veil-a),
      var(--veil-b) 45%,
      var(--veil-c)
    );
    transition: background 0.38s var(--ease);
  }
  /* 深色模式单独一档浓度，见 theme.ts 的 overlayDark */
  :global([data-theme="dark"]) .wp-veil {
    opacity: var(--ov-dark);
  }

  @media (max-width: 640px) {
    .wp-img {
      background-image: var(--wp-m);
    }
  }

  /* 花瓣 */
  .petals {
    position: absolute;
    inset: 0;
  }
  .petal {
    position: absolute;
    top: -6vh;
    left: var(--left);
    width: var(--s);
    height: var(--s);
    background: linear-gradient(
      135deg,
      oklch(95% 0.05 var(--hue)),
      oklch(86% 0.1 var(--hue))
    );
    border-radius: 100% 0 100% 0;
    opacity: 0;
    animation: fall var(--dur) linear var(--delay) infinite;
  }
  @keyframes fall {
    0% {
      transform: translateY(-8vh) translateX(0) rotate(0deg);
      opacity: 0;
    }
    12% {
      opacity: 0.75;
    }
    88% {
      opacity: 0.75;
    }
    100% {
      transform: translateY(108vh) translateX(var(--drift)) rotate(var(--spin));
      opacity: 0;
    }
  }

  /* 萤火虫：只在深色模式出现，与花瓣互换 */
  .fireflies {
    display: none;
    position: absolute;
    inset: 0;
  }
  :global([data-theme="dark"]) .petals {
    display: none;
  }
  :global([data-theme="dark"]) .fireflies {
    display: block;
  }
  .firefly {
    position: absolute;
    left: var(--left);
    top: var(--top);
    width: var(--s);
    height: var(--s);
    border-radius: 50%;
    background: oklch(93% 0.1 100 / 0.95);
    box-shadow:
      0 0 8px 2px oklch(88% 0.12 100 / 0.55),
      0 0 20px 6px oklch(85% 0.1 95 / 0.25);
    opacity: 0;
    animation: glow var(--dur) ease-in-out var(--delay) infinite;
  }
  @keyframes glow {
    0%,
    100% {
      transform: translate(0, 0);
      opacity: 0;
    }
    20% {
      opacity: 0.9;
    }
    50% {
      transform: translate(var(--dx), var(--dy));
      opacity: 0.35;
    }
    80% {
      opacity: 0.9;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .petals,
    .fireflies {
      display: none;
    }
  }
</style>
