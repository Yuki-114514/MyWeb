---
/*
 * SakuraMark —— 站点定制樱花标志。
 * 五瓣各自独立成型：长短宽窄、卷曲、缺刻深浅都不同，旋转故意偏离均分，
 * 径向渐变从根部深粉过渡到瓣尖浅粉（其中两瓣带紫），加 9 根花丝与米黄花药。
 * 调色不随主题切换（真实樱花本色），深浅底上均可读。
 * 导航、页脚、favicon 共用同一朵花。
 */
interface Props {
  /** 数字视为 px；字符串原样使用，如 "1.2em" */
  size?: number | string;
  class?: string;
}

const { size, class: className } = Astro.props;
const dim =
  size === undefined ? undefined : typeof size === "number" ? `${size}px` : size;
// 同页多个实例共存时避免渐变 id 冲突
const uid = Math.random().toString(36).slice(2, 8);
---

<svg
  viewBox="0 0 64 64"
  class:list={["sakura-mark", className]}
  style={dim ? { width: dim, height: dim } : undefined}
  aria-hidden="true"
  focusable="false"
>
  <defs>
    {/* 每瓣在自己的局部坐标系里从根部（花心）向瓣尖渐变 */}
    <radialGradient
      id={`ska-${uid}`}
      gradientUnits="userSpaceOnUse"
      cx="0"
      cy="-5"
      r="17"
    >
      <stop offset="0" stop-color="#f09aba" />
      <stop offset="0.45" stop-color="#f4b9d0" />
      <stop offset="1" stop-color="#fadcea" />
    </radialGradient>
    <radialGradient
      id={`skb-${uid}`}
      gradientUnits="userSpaceOnUse"
      cx="0"
      cy="-5"
      r="17"
    >
      <stop offset="0" stop-color="#ee98bc" />
      <stop offset="0.45" stop-color="#f2b6d2" />
      <stop offset="1" stop-color="#f2d9ee" />
    </radialGradient>
  </defs>
  <g transform="translate(32 32)">
    <!-- 喉部深色晕染 -->
    <circle r="5" fill="#e07ba4" opacity="0.5" />
    <!-- 五片不规则花瓣：rotate / scale 各不相同 -->
    <path
      fill={`url(#ska-${uid})`}
      stroke="#e995b5"
      stroke-width="0.35"
      stroke-opacity="0.45"
      transform="rotate(0)"
      d="M 0 -0.5 C 3.4 -2.2, 5.8 -6.8, 5.5 -12 C 5.3 -16, 4 -19.6, 2.1 -20.8 C 1.6 -18.3, 0.8 -17.2, 0 -16.4 C -0.8 -17.2, -1.6 -18.3, -2.1 -20.8 C -4 -19.6, -5.3 -16, -5.5 -12 C -5.8 -6.8, -3.4 -2.2, 0 -0.5 Z"
    />
    <path
      fill={`url(#skb-${uid})`}
      stroke="#e995b5"
      stroke-width="0.35"
      stroke-opacity="0.45"
      transform="rotate(67) scale(0.95)"
      d="M 0 -0.5 C 3.8 -2, 6.4 -6.5, 6 -11.5 C 5.7 -15.5, 4.2 -18.8, 2.3 -20 C 1.7 -17.6, 0.9 -16.7, 0 -15.9 C -0.9 -16.7, -1.7 -17.8, -2.4 -19.9 C -4.5 -18.7, -5.8 -15.2, -5.9 -11.5 C -6 -6.5, -3.2 -2, 0 -0.5 Z"
    />
    <path
      fill={`url(#ska-${uid})`}
      stroke="#e995b5"
      stroke-width="0.35"
      stroke-opacity="0.45"
      transform="rotate(146) scale(1.05)"
      d="M 0 -0.5 C 3 -2.4, 5.2 -7, 5 -12.5 C 4.9 -16.5, 3.6 -20.4, 1.9 -21.8 C 1.4 -19, 0.7 -18, 0 -17 C -0.7 -18, -1.4 -19, -1.9 -21.8 C -3.6 -20.4, -4.9 -16.5, -5 -12.5 C -5.2 -7, -3 -2.4, 0 -0.5 Z"
    />
    <path
      fill={`url(#skb-${uid})`}
      stroke="#e995b5"
      stroke-width="0.35"
      stroke-opacity="0.45"
      transform="rotate(215) scale(0.92)"
      d="M 0 -0.5 C 3.8 -2.4, 6.2 -6.8, 6 -11.5 C 5.8 -15, 4.4 -18, 2.5 -19.2 C 1.9 -16.3, 1 -15.3, 0 -14.5 C -1 -15.3, -1.9 -16.3, -2.5 -19.2 C -4.4 -18, -5.8 -15, -6 -11.5 C -6.2 -6.8, -3.8 -2.4, 0 -0.5 Z"
    />
    <path
      fill={`url(#ska-${uid})`}
      stroke="#e995b5"
      stroke-width="0.35"
      stroke-opacity="0.45"
      transform="rotate(289) scale(1.02)"
      d="M 0 -0.5 C 3.5 -2.3, 5.9 -7, 5.6 -12.2 C 5.4 -16.2, 4.1 -19.9, 2.4 -21.3 C 1.8 -18.6, 0.9 -17.6, 0 -16.7 C -0.8 -17.5, -1.5 -18.4, -1.8 -20.6 C -3.9 -19.5, -5.4 -15.8, -5.6 -11.8 C -5.9 -6.6, -3.3 -2.2, 0 -0.5 Z"
    />
    <!-- 花丝：白色细丝，角度长短不一 -->
    <g stroke="#ffffff" stroke-width="0.65" opacity="0.85">
      <line x1="0" y1="0" x2="2.6" y2="-8.1" />
      <line x1="0" y1="0" x2="5.7" y2="-4" />
      <line x1="0" y1="0" x2="9" y2="0" />
      <line x1="0" y1="0" x2="5.7" y2="4.8" />
      <line x1="0" y1="0" x2="2.1" y2="7.7" />
      <line x1="0" y1="0" x2="-2.4" y2="6.6" />
      <line x1="0" y1="0" x2="-7.6" y2="4.4" />
      <line x1="0" y1="0" x2="-6.2" y2="-3.6" />
      <line x1="0" y1="0" x2="-3.5" y2="-7.4" />
    </g>
    <!-- 花药 -->
    <g fill="#ffe08a">
      <circle cx="2.6" cy="-8.1" r="1.15" />
      <circle cx="5.7" cy="-4" r="1.15" />
      <circle cx="9" cy="0" r="1.3" />
      <circle cx="5.7" cy="4.8" r="1.15" />
      <circle cx="2.1" cy="7.7" r="1.15" />
      <circle cx="-2.4" cy="6.6" r="1.15" />
      <circle cx="-7.6" cy="4.4" r="1.15" />
      <circle cx="-6.2" cy="-3.6" r="1.15" />
      <circle cx="-3.5" cy="-7.4" r="1.15" />
    </g>
    <circle r="2.2" fill="#e98ab2" />
  </g>
</svg>
