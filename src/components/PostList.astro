---
import PostCard from "@/components/PostCard.astro";
import Icon from "@/components/Icon.astro";
import { pageHref, type Post } from "@/lib/posts";

interface Props {
  posts: Post[];
  /** 当前页码，从 1 开始 */
  page?: number;
  /** 总页数；<=1 时不渲染翻页条 */
  pages?: number;
  emptyText?: string;
}
const {
  posts,
  page = 1,
  pages = 1,
  emptyText = "还没有文章，第一篇正在酝酿中",
} = Astro.props;
---

<div class="posts-list">
  {
    posts.length === 0 ? (
      <p class="empty">
        {emptyText} <Icon name="feather" />
      </p>
    ) : (
      posts.map((post, i) => (
        <div class="reveal" data-delay={((i % 3) + 1) as 1 | 2 | 3}>
          <PostCard post={post} headingLevel={2} />
        </div>
      ))
    )
  }
</div>

{
  pages > 1 && (
    <nav class="pager" aria-label="文章分页">
      {page > 1 ? (
        <a href={pageHref(page - 1)} class="pager-link" rel="prev">
          ← 上一页
        </a>
      ) : (
        <span class="pager-link is-off" aria-hidden="true">
          ← 上一页
        </span>
      )}
      <span class="pager-now">
        第 {page} / {pages} 页
      </span>
      {page < pages ? (
        <a href={pageHref(page + 1)} class="pager-link" rel="next">
          下一页 →
        </a>
      ) : (
        <span class="pager-link is-off" aria-hidden="true">
          下一页 →
        </span>
      )}
    </nav>
  )
}

<style>
  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .empty {
    color: var(--ink-faint);
  }

  .pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.5rem;
    padding-top: 1.6rem;
    border-top: 1.5px dashed var(--line-strong);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-sm);
  }
  .pager-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 0.9rem;
    border-radius: var(--radius-pill);
    color: var(--sakura-deep);
    transition:
      background var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }
  .pager-link:hover {
    background: var(--sakura-soft);
  }
  .pager-link.is-off {
    color: var(--ink-faint);
    opacity: 0.5;
  }
  .pager-now {
    color: var(--ink-soft);
  }
</style>
