---
import type { Project } from "@/data/projects";
import Icon from "@/components/Icon.astro";

interface Props {
  project: Project;
  /** 卡片标题的层级。列表页父级只有 h1 时传 2，首页有 SectionHeading(h2) 时用默认的 3 */
  headingLevel?: 2 | 3;
}
const { project, headingLevel = 3 } = Astro.props;
const { title, description, tags, icon, accent, url, repo, year } = project;
const Title = `h${headingLevel}` as "h2" | "h3";
const hasLinks = Boolean(url || repo);
---

<article class:list={["proj card", `accent-${accent}`]}>
  <div class="proj-head">
    <span class="proj-icon" aria-hidden="true"><Icon name={icon} /></span>
    <span class="proj-year">{year}</span>
  </div>

  <Title class="proj-title">{title}</Title>
  <p class="proj-desc">{description}</p>

  <ul class="proj-tags">
    {tags.map((t) => <li class="proj-tag">{t}</li>)}
  </ul>

  {
    hasLinks && (
      <div class="proj-links">
        {url && (
          <a href={url} target="_blank" rel="noopener noreferrer" class="proj-link">
            去看看 <span aria-hidden="true">↗</span>
          </a>
        )}
        {repo && (
          <a
            href={repo}
            target="_blank"
            rel="noopener noreferrer"
            class="proj-link ghost"
          >
            源码
          </a>
        )}
      </div>
    )
  }
</article>

<style>
  .proj {
    --accent: var(--sakura);
    --accent-deep: var(--sakura-deep);
    --accent-soft: var(--sakura-soft);
    display: flex;
    flex-direction: column;
    padding: 1.6rem;
    height: 100%;
    overflow: hidden;
  }
  .proj::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
    background: linear-gradient(90deg, var(--accent), transparent);
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }
  .proj:hover {
    transform: translateY(-6px);
    border-color: var(--accent);
    box-shadow:
      0 0 0 1.5px var(--accent-soft),
      0 22px 44px -20px var(--accent);
  }
  .proj:hover::before {
    opacity: 1;
  }

  .accent-sakura {
    --accent: var(--sakura);
    --accent-deep: var(--sakura-deep);
    --accent-soft: var(--sakura-soft);
  }
  .accent-sky {
    --accent: var(--sky);
    --accent-deep: var(--sky-deep);
    --accent-soft: var(--sky-soft);
  }
  .accent-mint {
    --accent: var(--mint);
    --accent-deep: var(--mint-deep);
    --accent-soft: var(--mint-soft);
  }
  .accent-lavender {
    --accent: var(--lavender);
    --accent-deep: var(--lavender-deep);
    --accent-soft: var(--lavender-soft);
  }

  .proj-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }
  .proj-icon {
    display: grid;
    place-items: center;
    width: 3.2rem;
    height: 3.2rem;
    font-size: 1.7rem;
    color: var(--accent-deep);
    border-radius: var(--radius);
    background: var(--accent-soft);
    box-shadow: inset 0 0 0 1.5px oklch(100% 0 0 / 0.5);
    transition: transform var(--dur) var(--ease-soft);
  }
  .proj:hover .proj-icon {
    transform: rotate(-8deg) scale(1.08);
  }
  .proj-year {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    color: var(--accent-deep);
    background: var(--accent-soft);
    padding: 0.2em 0.7em;
    border-radius: var(--radius-pill);
  }

  .proj-title {
    font-size: var(--text-lg);
    margin-bottom: 0.5rem;
  }
  .proj-desc {
    color: var(--ink-soft);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    flex: 1;
  }

  .proj-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 1.1rem 0 0;
  }
  .proj-tag {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-xs);
    color: var(--ink-soft);
    background: var(--cream-2);
    border: 1px solid var(--line);
    padding: 0.24em 0.7em;
    border-radius: var(--radius-pill);
  }

  .proj-links {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.2rem;
    padding-top: 0.5rem;
    border-top: 1.5px dashed var(--line);
  }
  .proj-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    /* 命中区 44×44：min-height 管高，min-width 保「源码」这种两字链接不至于太窄 */
    min-height: 2.75rem;
    min-width: 2.75rem;
    padding-inline: 0.5rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    color: var(--accent-deep);
    transition: background var(--dur) var(--ease);
  }
  /* 首个链接的内边距往回收，文字仍与卡片其余内容左对齐 */
  .proj-links > :first-child {
    margin-left: -0.5rem;
  }
  .proj-link:hover {
    background: var(--accent-soft);
  }
  .proj-link.ghost {
    color: var(--ink-faint);
  }
  .proj-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
