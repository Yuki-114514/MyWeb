---
import { site } from "@/data/site";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(href + "/");
---

<header class="nav-wrap">
  <nav class="nav container" aria-label="主导航">
    <a href="/" class="brand" aria-label={`${site.name} 首页`}>
      <span class="brand-mark" aria-hidden="true">✿</span>
      <span class="brand-name">{site.name}</span>
    </a>

    <div class="nav-right">
      <ul class="nav-links">
        {
          site.nav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={["nav-link", { active: isActive(item.href) }]}
                aria-current={isActive(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <button
        class="theme-toggle"
        data-theme-toggle
        type="button"
        aria-label="切换深色 / 浅色模式"
        aria-pressed="false"
        title="切换深色 / 浅色"
      >
        <svg class="ico ico-moon" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"
            fill="currentColor"
          ></path>
        </svg>
        <svg class="ico ico-sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2" fill="currentColor"></circle>
          <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path
              d="M12 2.6v2.3M12 19.1v2.3M2.6 12h2.3M19.1 12h2.3M5 5l1.6 1.6M17.4 17.4 19 19M19 5l-1.6 1.6M6.6 17.4 5 19"
            ></path>
          </g>
        </svg>
      </button>
    </div>
  </nav>
</header>

<style>
  .nav-wrap {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-block: 0.7rem;
    background: oklch(98.7% 0.009 95 / 0.72);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1.5px solid oklch(91% 0.016 320 / 0.7);
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-lg);
    letter-spacing: -0.01em;
  }
  .brand-mark {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-pill);
    background: linear-gradient(135deg, var(--sakura), var(--lavender));
    color: white;
    font-size: 0.95rem;
    box-shadow: 0 6px 14px -6px oklch(70% 0.13 350 / 0.7);
    transition: transform var(--dur) var(--ease-soft);
  }
  .brand:hover .brand-mark {
    transform: rotate(90deg) scale(1.05);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(0.15rem, 1.5vw, 0.6rem);
    list-style: none;
    padding: 0.3rem;
    margin: 0;
    background: oklch(99.5% 0.004 95 / 0.6);
    border: 1.5px solid var(--line);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-sm);
  }
  .nav-link {
    display: inline-block;
    padding: 0.4rem clamp(0.6rem, 2.4vw, 1rem);
    border-radius: var(--radius-pill);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--ink-soft);
    transition:
      color var(--dur) var(--ease),
      background var(--dur) var(--ease);
  }
  .nav-link:hover {
    color: var(--sakura-deep);
  }
  .nav-link.active {
    color: var(--sakura-deep);
    background: var(--sakura-soft);
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    flex-shrink: 0;
    border-radius: var(--radius-pill);
    color: var(--ink-soft);
    background: oklch(99.5% 0.004 95 / 0.6);
    border: 1.5px solid var(--line);
    box-shadow: var(--shadow-sm);
    transition:
      color var(--dur) var(--ease),
      background var(--dur) var(--ease),
      transform var(--dur-fast) var(--ease-soft);
  }
  .theme-toggle:hover {
    color: var(--sakura-deep);
    transform: rotate(-12deg) scale(1.08);
  }
  .theme-toggle .ico {
    width: 18px;
    height: 18px;
  }
  .ico-sun {
    display: none;
  }
  :global(html[data-theme="dark"]) .ico-moon {
    display: none;
  }
  :global(html[data-theme="dark"]) .ico-sun {
    display: block;
  }

  /* 深色下的导航玻璃 */
  :global(html[data-theme="dark"]) .nav-wrap {
    background: oklch(22% 0.03 288 / 0.72);
    border-bottom-color: oklch(60% 0.03 300 / 0.18);
  }
  :global(html[data-theme="dark"]) .nav-links,
  :global(html[data-theme="dark"]) .theme-toggle {
    background: oklch(30% 0.03 290 / 0.5);
  }
</style>
