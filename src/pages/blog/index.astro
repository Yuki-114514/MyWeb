---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostList from "@/components/PostList.astro";
import TagRow from "@/components/TagRow.astro";
import { getSortedPosts, collectTags, PAGE_SIZE, totalPages } from "@/lib/posts";

const posts = await getSortedPosts();
const tags = collectTags(posts);
const pages = totalPages(posts.length);
---

<BaseLayout title="博客" description="技术笔记、生活随想，和一些软软的碎碎念。">
  <section class="container container-narrow">
    <header class="page-head rise">
      <span class="eyebrow">✦ Blog</span>
      <h1 class="page-title">碎碎念 &amp; 笔记本</h1>
      <p class="page-lede">
        这里存着我想留久一点的文字——技术踩坑、生活小事、看番心得。想到什么写什么，随缘更新。
      </p>
      {tags.length > 0 && <TagRow tags={tags} showCount class="head-tags" />}
    </header>

    <PostList posts={posts.slice(0, PAGE_SIZE)} page={1} pages={pages} />
  </section>
</BaseLayout>

<style>
  .page-head {
    margin-bottom: 3rem;
    padding-top: 2rem;
  }
  .page-title {
    font-size: var(--text-2xl);
    margin-top: 0.6rem;
    margin-bottom: 0.9rem;
  }
  .page-lede {
    color: var(--ink-soft);
    font-size: var(--text-lg);
  }
  .head-tags {
    margin-top: 1.5rem;
  }
</style>
