---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import Icon from "@/components/Icon.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const allTags = [...new Set(posts.flatMap((p) => p.data.tags))];
---

<BaseLayout title="博客" description="技术笔记、生活随想，和一些软软的碎碎念。">
  <section class="container container-narrow">
    <header class="page-head reveal">
      <span class="eyebrow">✦ Blog</span>
      <h1 class="page-title">碎碎念 &amp; 笔记本</h1>
      <p class="page-lede">
        这里存着我想留久一点的文字——技术踩坑、生活小事、看番心得。想到什么写什么，随缘更新。
      </p>
      {
        allTags.length > 0 && (
          <ul class="tag-row">
            {allTags.map((t) => (
              <li class="pill">#{t}</li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="posts-list">
      {
        posts.length === 0 ? (
          <p class="empty">
            还没有文章，第一篇正在酝酿中 <Icon name="feather" />
          </p>
        ) : (
          posts.map((post, i) => (
            <div class="reveal" data-delay={((i % 3) + 1) as 1 | 2 | 3}>
              <PostCard post={post} />
            </div>
          ))
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    margin-bottom: 3rem;
    padding-top: 2rem;
  }
  .page-title {
    font-size: var(--text-2xl);
    margin-top: 0.6rem;
    margin-bottom: 0.9rem;
  }
  .page-lede {
    color: var(--ink-soft);
    font-size: var(--text-lg);
  }
  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin-top: 1.5rem;
  }
  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .empty {
    color: var(--ink-faint);
  }
</style>
