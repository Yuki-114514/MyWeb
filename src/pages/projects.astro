---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { projects } from "@/data/projects";
import ProjectCard from "@/components/ProjectCard.astro";
import Icon from "@/components/Icon.astro";

const sorted = [...projects].sort((a, b) => b.year.localeCompare(a.year));
---

<BaseLayout title="项目" description="我做过的一些小工具和小玩意儿。">
  <section class="container">
    <header class="page-head rise">
      <span class="eyebrow">✦ Projects</span>
      <h1 class="page-title">我造的小东西</h1>
      <p class="page-lede">
        这些都是我利用业余时间捣鼓出来的小项目。有的解决了我自己的小烦恼，有的纯粹是好玩。
        欢迎点进去看看，或者去 GitHub 翻翻源码～
      </p>
    </header>

    <div class="proj-grid">
      {
        projects.length === 0 ? (
          <p class="empty">还没有项目，敬请期待呀 <Icon name="plant" /></p>
        ) : (
          sorted.map((p, i) => (
            <div class="reveal" data-delay={((i % 3) + 1) as 1 | 2 | 3}>
              <ProjectCard project={p} headingLevel={2} />
            </div>
          ))
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    max-width: 40rem;
    margin-bottom: 3rem;
    padding-top: 2rem;
  }
  .page-title {
    font-size: var(--text-2xl);
    margin-top: 0.6rem;
    margin-bottom: 0.9rem;
  }
  .page-lede {
    color: var(--ink-soft);
    font-size: var(--text-lg);
  }
  .proj-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 1.4rem;
  }
  .empty {
    color: var(--ink-faint);
  }
</style>
