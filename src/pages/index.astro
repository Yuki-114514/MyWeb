---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site } from "@/data/site";
import { theme } from "@/data/theme";
import { projects } from "@/data/projects";
import Avatar from "@/components/Avatar.astro";
import SocialLinks from "@/components/SocialLinks.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import PostCard from "@/components/PostCard.astro";
import Icon from "@/components/Icon.astro";
import type { IconName } from "@/data/icons";

const featured = projects.filter((p) => p.featured).slice(0, 4);
const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const roles: { icon: IconName; label: string }[] = [
  { icon: "code", label: "独立开发" },
  { icon: "pen-nib", label: "写作" },
  { icon: "game-controller", label: "二次元" },
];
---

<BaseLayout>
  <!-- ============ HERO ============ -->
  <section class="hero container" aria-labelledby="hero-heading">
    <div class="hero-text">
      <p class="hero-hello reveal">
        <Icon name="hand-waving" class="wave" /> 你好呀，欢迎来到我的小站
      </p>
      <h1 id="hero-heading" class="hero-h1 reveal" data-delay="1">
        我是 <span class="name">{site.name}</span>，<br />{site.role}。
      </h1>
      <p class="hero-tagline reveal" data-delay="2">{site.tagline}</p>
      <p class="hero-intro reveal" data-delay="2">{site.intro}</p>

      {
        theme.hitokoto && (
          <p class="hero-hitokoto reveal" data-delay="2">
            <span class="hk-mark" aria-hidden="true">
              ❞
            </span>
            <span class="hk-text">愿你我都能成为温柔的大人。</span>
          </p>
        )
      }

      <ul class="hero-roles reveal" data-delay="3">
        {
          roles.map((r) => (
            <li class="pill pill--pink">
              <Icon name={r.icon} />
              {r.label}
            </li>
          ))
        }
      </ul>

      <div class="hero-actions reveal" data-delay="3">
        <a href="/projects" class="btn btn--primary">看看项目 ✦</a>
        <a href="/blog" class="btn btn--ghost">读读博客</a>
      </div>

      <div class="hero-social reveal" data-delay="4">
        <span class="hero-social-label">在这些地方找到我 →</span>
        <SocialLinks />
      </div>
    </div>

    <div class="hero-visual reveal" data-delay="2">
      <div class="tilt">
        <span class="deco deco--star1" aria-hidden="true">✦</span>
        <span class="deco deco--star2" aria-hidden="true">✧</span>
        <Icon name="flower" class="deco deco--heart" />
        {
          theme.heroCharacter ? (
            <figure class="char-frame">
              <img
                class="char-img"
                src={theme.heroCharacter}
                alt="角色立绘"
                loading="eager"
              />
              <figcaption class="char-tag">◍ 我的搭子</figcaption>
            </figure>
          ) : (
            <div class="halo-wrap">
              <div class="halo-ring" aria-hidden="true" />
              <Avatar size={210} />
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- ============ FEATURED PROJECTS ============ -->
  <section class="section container" aria-labelledby="proj-heading">
    <div class="reveal">
      <SectionHeading eyebrow="Made with love" title="精选作品" />
    </div>
    <div class="proj-grid">
      {
        featured.map((p, i) => (
          <div class="reveal" data-delay={((i % 3) + 1) as 1 | 2 | 3}>
            <ProjectCard project={p} />
          </div>
        ))
      }
    </div>
    <div class="more-row reveal">
      <a href="/projects" class="link">查看全部项目 →</a>
    </div>
  </section>

  <!-- ============ RECENT WRITING ============ -->
  <section class="section container container-narrow" aria-labelledby="posts-heading">
    <div class="reveal">
      <SectionHeading eyebrow="From the blog" title="最近写的字" align="center" />
    </div>
    <div class="posts-list">
      {
        posts.map((post, i) => (
          <div class="reveal" data-delay={((i % 3) + 1) as 1 | 2 | 3}>
            <PostCard post={post} />
          </div>
        ))
      }
    </div>
    <div class="more-row reveal" style="text-align:center">
      <a href="/blog" class="link">翻翻更多文章 →</a>
    </div>
  </section>

  <!-- ============ CLOSING CTA ============ -->
  <section class="container">
    <div class="cta reveal">
      <Icon name="chats-circle" class="cta-icon" />
      <h2 class="cta-title">想聊聊天？</h2>
      <p class="cta-text">
        无论是合作、约稿，还是单纯想打个招呼——都欢迎来找我呀。
      </p>
      <a href={`mailto:${site.email}`} class="btn btn--primary">
        给我写封信 <Icon name="paper-plane-tilt" />
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  // 「一言」：抓一句随机短句填进 hero；失败就保留静态兜底文案。
  function loadHitokoto() {
    const el = document.querySelector(".hk-text");
    if (!el) return;
    fetch("https://v1.hitokoto.cn/?c=a&c=b&c=d&c=i&c=k&encode=json")
      .then((r) => r.json())
      .then((d) => {
        if (d && d.hitokoto) el.textContent = d.hitokoto;
      })
      .catch(() => {});
  }
  loadHitokoto();
  document.addEventListener("astro:page-load", loadHitokoto);

  // Hero 立绘 / 头像随鼠标轻微 3D 倾斜（触屏与减弱动效时关闭）
  function initTilt() {
    const visual = document.querySelector<HTMLElement>(".hero-visual");
    const tilt = visual?.querySelector<HTMLElement>(".tilt");
    if (!visual || !tilt) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    if (window.matchMedia("(pointer: coarse)").matches) return;
    const MAX = 7; // 最大倾角（度）
    visual.addEventListener("mousemove", (e) => {
      const r = visual.getBoundingClientRect();
      const px = (e.clientX - r.left) / r.width - 0.5;
      const py = (e.clientY - r.top) / r.height - 0.5;
      tilt.style.setProperty("--ry", `${(px * MAX * 2).toFixed(2)}deg`);
      tilt.style.setProperty("--rx", `${(-py * MAX * 2).toFixed(2)}deg`);
    });
    visual.addEventListener("mouseleave", () => {
      tilt.style.setProperty("--rx", "0deg");
      tilt.style.setProperty("--ry", "0deg");
    });
  }
  initTilt();
  document.addEventListener("astro:page-load", initTilt);
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: 2rem;
    padding-top: clamp(2.5rem, 6vw, 5rem);
    padding-bottom: clamp(2rem, 5vw, 4rem);
  }
  .hero-hello {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--ink-soft);
    background: var(--paper);
    border: 1.5px solid var(--line);
    box-shadow: var(--shadow-sm);
    padding: 0.45rem 1rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
  }
  .wave {
    display: inline-block;
    color: var(--sakura-deep);
    animation: wave 2.6s ease-in-out infinite;
    transform-origin: 70% 70%;
  }
  @keyframes wave {
    0%, 60%, 100% { transform: rotate(0); }
    10%, 30% { transform: rotate(16deg); }
    20% { transform: rotate(-10deg); }
  }

  .hero-h1 {
    font-size: var(--text-hero);
    margin-top: 1.3rem;
    line-height: 1.08;
  }
  .name {
    background: linear-gradient(120deg, var(--sakura-deep), var(--lavender-deep) 60%, var(--sky-deep));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-tagline {
    margin-top: 1.2rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-lg);
    color: var(--sakura-deep);
  }
  .hero-intro {
    margin-top: 0.7rem;
    max-width: 34rem;
    color: var(--ink-soft);
  }
  .hero-roles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin-top: 1.4rem;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.8rem;
  }
  .hero-social {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem;
    margin-top: 2rem;
  }
  .hero-social-label {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--ink-faint);
  }

  .hero-hitokoto {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    max-width: 32rem;
    margin-top: 1rem;
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }
  .hk-mark {
    font-size: 1.5rem;
    line-height: 0.8;
    color: var(--sakura);
  }

  /* 壁纸之上保证文字清晰（光晕随主题切换） */
  .hero-h1,
  .hero-tagline,
  .hero-intro,
  .hero-hitokoto {
    text-shadow: 0 1px 16px var(--hero-halo);
  }

  /* ---------- Hero visual ---------- */
  .hero-visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 320px;
    perspective: 800px;
  }
  /* 鼠标视差倾斜层：包住立绘与装饰，角度由 JS 写入 --rx/--ry */
  .tilt {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.3s var(--ease);
    will-change: transform;
  }
  .halo-ring {
    position: absolute;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    background:
      radial-gradient(circle at 50% 50%, transparent 58%, oklch(93% 0.05 350 / 0.55) 60%, transparent 72%);
    border: 2px dashed oklch(88% 0.06 340 / 0.7);
    animation: spin 40s linear infinite;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  .deco {
    position: absolute;
    font-size: 1.5rem;
    color: var(--lavender-deep);
    animation: twinkle 3s ease-in-out infinite;
  }
  .deco--star1 { top: 6%; left: 16%; color: var(--sakura-deep); }
  .deco--star2 { bottom: 14%; right: 12%; animation-delay: 1s; font-size: 1.9rem; }
  .deco--heart { top: 18%; right: 8%; animation-delay: 0.5s; font-size: 1.8rem; color: var(--sakura-deep); }
  @keyframes twinkle {
    0%, 100% { opacity: 0.4; transform: scale(0.85); }
    50% { opacity: 1; transform: scale(1.1); }
  }
  .halo-wrap {
    position: relative;
    display: grid;
    place-items: center;
  }

  /* 角色立绘相框 */
  .char-frame {
    position: relative;
    margin: 0;
    width: min(300px, 74vw);
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-xl);
    overflow: hidden;
    padding: 8px;
    background: var(--glass-bg-strong);
    backdrop-filter: blur(var(--glass-blur)) saturate(1.4);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(1.4);
    border: 1.5px solid var(--glass-border);
    box-shadow: var(--shadow-lg);
    transform: rotate(2.2deg);
    transition:
      transform var(--dur) var(--ease-soft),
      box-shadow var(--dur) var(--ease);
    animation: float-frame 6s var(--ease) infinite;
  }
  .char-frame:hover {
    transform: rotate(0deg) scale(1.02);
  }
  .char-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: calc(var(--radius-xl) - 8px);
  }
  .char-tag {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-pill);
    background: oklch(40% 0.04 320 / 0.42);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    color: white;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-xs);
    letter-spacing: 0.03em;
  }
  @keyframes float-frame {
    0%, 100% { transform: rotate(2.2deg) translateY(0); }
    50% { transform: rotate(2.2deg) translateY(-12px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .char-frame { animation: none; }
  }

  /* ---------- Grids ---------- */
  .proj-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15.5rem, 1fr));
    gap: 1.3rem;
  }
  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .more-row {
    margin-top: 2rem;
  }

  /* ---------- CTA ---------- */
  .cta {
    text-align: center;
    padding: clamp(2.5rem, 5vw, 4rem);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(120% 120% at 50% 0%, oklch(90% 0.07 350 / 0.55), transparent 62%),
      linear-gradient(160deg, oklch(97% 0.014 330 / 0.62), oklch(93% 0.04 232 / 0.62));
    backdrop-filter: blur(12px) saturate(1.4);
    -webkit-backdrop-filter: blur(12px) saturate(1.4);
    border: 1.5px solid var(--glass-border);
    box-shadow: var(--shadow-lg);
  }
  .cta-icon {
    font-size: 2.6rem;
    color: var(--sakura-deep);
  }
  .cta-title {
    font-size: var(--text-2xl);
    margin-top: 0.5rem;
  }
  .cta-text {
    max-width: 28rem;
    margin: 0.8rem auto 1.6rem;
    color: var(--ink-soft);
  }
  :global(html[data-theme="dark"]) .cta {
    background:
      radial-gradient(120% 120% at 50% 0%, oklch(55% 0.1 350 / 0.32), transparent 62%),
      linear-gradient(160deg, oklch(30% 0.03 300 / 0.62), oklch(28% 0.04 250 / 0.62));
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 52rem) {
    .hero {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .hero-visual {
      order: -1;
      min-height: 260px;
    }
    .hero-hello,
    .hero-roles,
    .hero-actions,
    .hero-social {
      justify-content: center;
    }
    .hero-intro {
      margin-inline: auto;
    }
  }
</style>
